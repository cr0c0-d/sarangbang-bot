# ─────────────────────────────────────────────
# 1) 봇 기본 정보 (필수)
# ─────────────────────────────────────────────
# Discord Developer Portal > Bot > Reset Token 에서 복사
DISCORD_TOKEN=여기에_봇_토큰
# Developer Portal > General Information > Application ID
CLIENT_ID=여기에_애플리케이션_ID
# 봇을 쓸 디스코드 서버 ID (디스코드 설정 > 고급 > 개발자 모드 켜고, 서버 아이콘 우클릭 > ID 복사)
# 여러 서버에서 쓰려면 쉼표로 나열하세요. 공백은 넣어도 됩니다.
#   GUILD_ID=123456789012345678,987654321098765432
# 서버를 추가한 뒤에는 npm run deploy 를 다시 실행해야 그 서버에 명령어가 보입니다.
GUILD_ID=여기에_서버_ID

# 이 파일은 **망고** 설정입니다. 그대로 두세요.
#   mango — 망고 (읽어주기·타이머·이미지)      ← 이 파일
#   music — 노래하는 망고 (음악)               ← .env.music
# 음악은 별도의 봇입니다. 음악까지 쓰려면 .env.music.example 을
# .env.music 으로 복사하세요. (README 「노래하는 망고 띄우기」 참고)
BOT_ROLE=mango

# ─────────────────────────────────────────────
# ※ 아래 채널 ID들은 디스코드에서 /채널설정 명령으로도 바꿀 수 있습니다.
#    명령어로 지정한 값이 이 파일보다 우선합니다.
#    지금 무엇이 적용 중인지는 /채널확인 으로 볼 수 있고,
#    /채널해제 하면 이 파일의 값으로 돌아갑니다.
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
# 2) 음악 — **노래하는 망고 전용입니다**
# ─────────────────────────────────────────────
# 아래 항목들은 .env.music 을 쓰는 음악 봇에서만 의미가 있습니다.
# 망고(이 파일)는 음악을 아예 하지 않으므로 비워두셔도 됩니다.
# .env.music 에 안 적으면 이 파일 값을 그대로 물려받으므로 여기 적어두는 편이 편합니다.
#
# 유튜브 링크를 감시할 채팅방 ID. 비워두면 모든 채팅방에서 동작합니다.
# 참고: 봇이 둘로 나뉘어 있으므로, 읽어주기 채팅방에 유튜브 링크를 쓰면
# 노래하는 망고가 재생하고 망고는 그 링크를 "링크" 라고만 읽습니다.
MUSIC_TEXT_CHANNEL_ID=
# 봇이 들어갈 음성채널 ID. 비워두면 명령한 사람이 있는 음성채널로 들어갑니다.
MUSIC_VOICE_CHANNEL_ID=
# 마지막 곡이 끝난 뒤 음성채널에서 나가기까지 대기 시간(초). 0이면 안 나감.
# ⚠️ **음성채널에 사람이 남아 있으면 이 시간이 지나도 나가지 않습니다.**
#    아무도 없어지면 그때 바로 나갑니다. (조용하다고 대화 중에 사라지면 안 되므로)
MUSIC_LEAVE_AFTER_SEC=300

# ─────────────────────────────────────────────
# 3) TTS 기능
# ─────────────────────────────────────────────
# 이 채팅방의 메시지를 읽어줍니다. 비워두면 TTS 기능이 꺼집니다.
TTS_TEXT_CHANNEL_ID=
# 읽어줄 음성채널 ID. 비워두면 말한 사람이 있는 음성채널로 들어갑니다.
TTS_VOICE_CHANNEL_ID=
# 서버 기본 목소리. 쓸 수 있는 목록은 src/tts/voices.js 에 14종 있습니다.
# 이건 **서버 전체 기본값**입니다. 각자 /목소리 로 자기 목소리를 따로 고를 수 있습니다.
# ⚠️ 한국어 전용 목소리(선희·인준)는 일본어를 만나면 소리를 아예 내지 않습니다(실측).
#    "다국어" 목소리는 영어·일본어가 섞여도 자연스럽게 읽습니다. 기본값을 권장합니다.
TTS_VOICE=ko-KR-HyunsuMultilingualNeural
# 한 번에 읽어줄 최대 글자 수 (넘으면 잘라서 읽음)
TTS_MAX_CHARS=200
# ㅋㅋㅋㅋㅋ 처럼 같은 글자가 반복될 때 몇 개까지 읽을지.
# 20개를 그대로 읽으면 그 소리만 한참 나지만, 웃음 길이도 표현이라 너무 짧으면 심심합니다.
TTS_MAX_REPEAT=6
# 읽는 속도(%). 100 = 원래 속도. 50~200 사이.
# 이건 **서버 기본값**입니다. 각자 /목소리 속도:130 으로 자기 속도를 따로 정할 수 있습니다.
TTS_SPEED=100
# 말하는 사람 이름도 같이 읽을지 (true/false)
TTS_READ_AUTHOR=false

# ─────────────────────────────────────────────
# 4) 이미지 정리 기능
# ─────────────────────────────────────────────
# 봇이 설정을 기억하는 폴더 (/채널설정 으로 바꾼 값이 여기 저장됩니다)
DATA_DIR=./data

# 이미지를 감시할 채팅방 ID (쉼표로 여러 개 가능).
# **비워두면 봇이 볼 수 있는 모든 채널**의 사진을 저장합니다. 지정하면 그 채널들만.
IMAGE_CHANNEL_ID=
# 반대로 **여기 적은 채널만 빼고** 싶을 때 (쉼표로 여러 개).
# 위 목록보다 **우선**입니다 — 여기 있으면 무조건 저장하지 않습니다.
# 디스코드에서 `/채널설정 종류:이미지 제외 채널` 로도 지정할 수 있습니다.
IMAGE_EXCLUDE_CHANNEL_ID=
# 폴더 이름은 기본적으로 "채널 이름"을 씁니다. (스레드면 스레드 이름)
# 디스코드에서 /폴더 <이름> 으로 채널마다 다른 이름을 줄 수도 있습니다.
#
# 이미지를 저장할 폴더 (상대경로면 프로젝트 기준)
IMAGE_DIR=./data/images
# 이미지 갤러리 웹페이지 포트
WEB_PORT=3000
# 웹서버를 어디에 열지.
#   0.0.0.0   = 다른 기기에서도 접속 가능 (집 PC에서 쓸 때 기본값)
#   127.0.0.1 = 이 컴퓨터 안에서만. 서버(VPS)에 올린 뒤 SSH 터널로 볼 때 쓰세요.
#               포트를 인터넷에 열지 않아도 되어 훨씬 안전합니다.
WEB_BIND=0.0.0.0
# 브라우저에서 접속할 주소. VPS로 옮기면 http://서버IP:3000 으로 바꾸세요.
WEB_PUBLIC_URL=http://localhost:3000
# 갤러리 접속 암호. 아무 문자열이나 길게 넣으세요. 비우면 암호 없이 열립니다.
WEB_TOKEN=

# ─────────────────────────────────────────────
# 4-0) 일정 · 정산 — 망고
# ─────────────────────────────────────────────
# /일정새로 로 만든 일정 채널이 들어갈 카테고리 ID.
# 디스코드에서 /채널설정 종류:일정 카테고리 로 지정하는 편이 훨씬 쉽습니다.
# 봇에게 "채널 관리" 권한이 있어야 채널을 만들 수 있습니다.
PLAN_CATEGORY_ID=

# ─────────────────────────────────────────────
# 4-0b) 방송 기록 (타임머신) — 망고
# ─────────────────────────────────────────────
# 유튜브 라이브를 켜고 게임할 때, 재미있던 순간을 버튼 한 번으로 찍어두는 기능입니다.
# 제어판이 상주할 채팅방 ID. /채널설정 종류:방송 채널 로 지정하는 편이 훨씬 쉽습니다.
# 그 채널은 일반 사용자의 "메시지 보내기" 를 막아두세요 — 제어판이 채팅에 밀리지 않습니다.
# ("애플리케이션 명령어 사용" 은 켜둬야 /방송 을 쓸 수 있습니다)
STREAM_CHANNEL_ID=

# 클립을 만들 때 기본으로 잡을 구간 (마킹 앞 / 뒤, 초). 창에서 고칠 수 있습니다.
STREAM_CLIP_BEFORE_SEC=15
STREAM_CLIP_AFTER_SEC=25

# ⚠️ 클립 하나의 최대 길이(초). **이게 실질적인 용량 상한입니다.**
#    720p 는 초당 약 0.19MB 입니다 (실측: 15초 = 2.4MB). 180초면 한 개 약 34MB.
#    이걸 풀면 한 번에 30분(약 340MB)을 요청할 수 있고, 개수 제한으로는 못 막습니다.
#    디스크가 차면 사진 자동 정리가 돌아 **원인은 그대로 둔 채 사진이 지워집니다.**
STREAM_CLIP_MAX_SEC=180

# 클립 화질(세로 픽셀). 낮추면 용량이 줄고, 재인코딩이 아니라 낮은 포맷을 고르는 것이라 공짜입니다.
STREAM_CLIP_MAX_HEIGHT=720

# 클립 개수 상한. 넘으면 오래된 것부터 지우고 알려줍니다.
STREAM_CLIP_PER_SESSION=20
STREAM_CLIP_TOTAL=200

# 클립 폴더가 쓸 수 있는 용량(GB). 넘으면 오래된 것부터 지우고 방송 채널에 알립니다.
# ⚠️ 사진 예산(IMAGE_MAX_GB)과 **따로**입니다. 하나로 합치면 클립이 늘 때 사진이 지워집니다.
STREAM_CLIP_AUTO_CLEANUP=true
STREAM_CLIP_MAX_GB=5
# 이만큼 안 지난 클립은 예산을 넘겨도 지우지 않습니다. 방금 만든 것이 사라지면 안 됩니다.
STREAM_CLIP_MIN_KEEP_DAYS=3
# 한 번 정리할 때 예산의 몇 %까지 내려갈지. 경계선에서 매번 재실행되는 것을 막습니다.
STREAM_CLIP_CLEANUP_TARGET_PERCENT=80

# ─────────────────────────────────────────────
# 4-0c) 클립을 구글 드라이브에도 올리기 — 망고 · 선택
# ─────────────────────────────────────────────
# ⚠️ **안 해도 됩니다.** 비워두면 조용히 꺼지고, 클립은 웹페이지에서 그대로 보고 받습니다.
# ⚠️ 이 기능은 **실제 구글 API 로 검증하지 못했습니다** (자격증명이 필요해서).
#    처음 쓸 때 오류가 나면 구글이 한 말이 그대로 보이니 그걸 보고 고치세요.
#    자세한 사정은 docs/게임방송-기획.md 7절.
#
# 받는 순서는 README 의 "클립을 구글 드라이브에 올리기" 에 있습니다.
# 로컬 파일은 **지우지 않습니다.** 사본만 올립니다.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
# 비워두면 내 드라이브 최상위에 올라갑니다. 폴더 주소의 마지막 부분이 ID 입니다.
GDRIVE_FOLDER_ID=
# 링크를 아는 사람이 볼 수 있게 할지. 클립 웹페이지와 같은 수준입니다.
GDRIVE_SHARE_ANYONE=true

# ⚠️ 방송 기록은 yt-dlp 로 방송 시작 시각을 읽습니다. 그런데 망고는 .env 만 읽습니다
#    (음악 봇만 .env.music 을 함께 읽습니다). 음악 봇 쪽에 아래를 넣어두셨다면
#    **여기에도 같은 값이 필요합니다.** 안 넣으면 기동이 느리거나 유튜브에 막힙니다.
#      YTDLP_PATH=/home/ubuntu/.venv-ytdlp/bin/yt-dlp
#      YTDLP_COOKIES_FILE=/home/ubuntu/cookies.txt

# ─────────────────────────────────────────────
# 4-1) 영화 고르기 (TMDB) — 망고
# ─────────────────────────────────────────────
# https://www.themoviedb.org 가입 → 설정 → API 에서 받습니다. 무료입니다.
# 두 가지를 주는데 **"API 읽기 액세스 토큰"**(길고 eyJ 로 시작) 을 넣으세요.
# 비워두면 /영화 가 발급 방법만 안내하고 기능은 꺼집니다. 봇은 정상 동작합니다.
TMDB_READ_TOKEN=
# 예전 방식(v3) 키. 위를 넣었으면 안 넣어도 됩니다.
TMDB_API_KEY=

# ─────────────────────────────────────────────
# 5) 유튜브 차단 우회 — **노래하는 망고 전용입니다**
# ─────────────────────────────────────────────
# yt-dlp 는 음악 봇만 돌립니다. 그래서 이 항목들의 제자리는 **`.env.music`** 입니다.
# 여기 적어도 상속되어 동작하지만, 나중에 "쿠키를 어디 적었더라" 를 겪게 됩니다.
# 음악을 안 쓰시면 이 절은 통째로 무시하세요.
#
# Oracle/AWS/GCP 같은 클라우드 서버에서 돌리면 유튜브가 그 IP를 거의 반드시 막습니다.
# 그때 브라우저에서 뽑은 쿠키 파일 경로를 넣어주면 대부분 풀립니다.
# ⚠️ 본인 주계정 쿠키를 쓰지 마세요. 계정이 제한될 수 있습니다. 따로 만든 계정을 쓰세요.
# (README의 "유튜브가 막힐 때" 항목에 진단 명령과 대안이 있습니다)
YTDLP_COOKIES_FILE=
# 프록시를 거쳐야 한다면 (예: http://127.0.0.1:8080)
YTDLP_PROXY=
# yt-dlp 에 추가로 넘길 옵션이 있으면 (공백으로 구분)
YTDLP_EXTRA_ARGS=
# 느린 서버에서 yt-dlp 기동 비용을 줄이고 싶을 때 (기본 true 권장)
# 끄면 "n challenge solving failed" 가 나고 재생이 안 될 수 있습니다.
YTDLP_JS_RUNTIME=true

# ─────────────────────────────────────────────
# 6) 사진 용량 자동 정리
# ─────────────────────────────────────────────
# 사진은 계속 쌓이기만 하므로 언젠가 디스크가 찹니다.
# 오래된 것부터 자동으로 지워서 용량을 유지합니다.
#
# ⚠️ 기준을 "디스크의 몇 %" 로 잡지 않았습니다.
#    디스크에는 OS·로그도 같이 있어서, 로그가 폭주해 디스크가 찼을 때
#    사진을 지우면 원인은 그대로 둔 채 데이터만 잃게 됩니다.
#    그래서 **이미지가 쓸 수 있는 예산**을 정하는 방식입니다.

# 자동 정리 사용 여부
IMAGE_AUTO_CLEANUP=true
# 사진이 쓸 수 있는 최대 용량(GB). 이걸 넘으면 오래된 것부터 지웁니다.
# Oracle 무료 47GB 부팅 볼륨 기준 15GB 권장 (OS·스왑·node_modules 로 약 10GB 씀)
IMAGE_MAX_GB=15
# 정리할 때 예산의 몇 %까지 내려갈지. 경계선에서 매번 도는 것을 막습니다.
IMAGE_CLEANUP_TARGET_PERCENT=80
# 최근 며칠 이내 사진은 지우지 않습니다 (실수·버그로 방금 올린 사진이 날아가는 것 방지)
IMAGE_MIN_KEEP_DAYS=7
# 디스크 여유가 이 값보다 적어지면, 예산과 무관하게 정리합니다.
# 이때는 "최근 N일 보호"도 해제됩니다 — 서버가 죽는 것보다는 낫기 때문입니다.
IMAGE_MIN_FREE_GB=2

# ─────────────────────────────────────────────
# 8) 망고야 (/망고야) — 제미나이에게 물어보기
# ─────────────────────────────────────────────
# ⚠️ 구독(ChatGPT Plus · Google AI Pro)과는 **완전히 별개**입니다.
#    봇이 쓰는 건 API 라 키를 따로 발급받아야 합니다.
#
# 키 받기: https://aistudio.google.com/apikey
#   구글 계정으로 로그인 → "Create API key" → 복사해서 아래에 붙여넣기
#   **카드 등록 없이** 무료 등급으로 시작할 수 있습니다 (분당·하루 횟수 제한 있음).
#   현재 한도: https://aistudio.google.com/rate-limit
#   ⚠️ 무료 등급은 보낸 내용이 구글의 서비스 개선에 쓰일 수 있습니다. 약관을 확인하세요.
GEMINI_API_KEY=

# 쓸 모델. **무료로 쓰려면 Flash 계열**을 고르세요 (Pro 계열은 유료 전용).
# 모델 이름은 자주 바뀝니다. 봇이 "모델을 찾을 수 없습니다" 라고 하면 여기를 고치세요.
GEMINI_MODEL=gemini-3.6-flash

# ── 한도 — 친구들이 같이 쓰므로 이게 없으면 한 사람이 다 써버립니다 ──
# 질문 길이 상한(글자). 긴 글을 통째로 붙여넣으면 답보다 질문이 더 비쌉니다.
AI_MAX_INPUT_CHARS=1000
# 답 길이 상한(토큰). 한 번의 최대 비용을 고정합니다.
# 자세한 답을 원해서 1500 으로 뒀습니다. 답이 자꾸 잘리면 올리세요
# ("답이 길어서 잘렸습니다" 라고 봇이 알려줍니다).
AI_MAX_OUTPUT_TOKENS=1500
# 제미나이가 답하기 전에 "생각" 을 얼마나 할지. low / medium / high
# ⚠️ 생각도 위 출력 토큰을 먹습니다. 높이면 답이 잘릴 수 있으니 함께 올리세요.
AI_THINKING_LEVEL=low
# 한 사람이 1시간에 몇 번까지. **0 = 안 씀 (기본)**
# 소유자 결정: 사람당으로 나누지 않고 **서버 통합 한도만** 둡니다.
# 친구 사이에 각자 몫을 정해두는 게 오히려 어색하다는 판단입니다.
# 한 사람이 몰아 쓰는 게 거슬리면 여기에 숫자를 넣으세요 (예: 20).
AI_PER_USER_HOURLY=0
# 서버 하나가 하루에 몇 번까지. 0이면 무제한(권장하지 않음).
#
# 어떻게 정하나: **자주 쓰는 사람 수 × 1인당 하루 몇 번**으로 잡으면 됩니다.
#   5명 × 30번 = 150   ← 기본값 (소유자 서버 기준)
#
# ⚠️ 위쪽 천장은 우리가 아니라 **제미나이 무료 등급의 하루 요청 수**입니다.
#    서버가 여러 개면 (서버 수 × 이 값) 이 그 천장을 넘지 않아야 합니다.
#    내 실제 한도: https://aistudio.google.com/rate-limit
#    넘겨도 큰일은 아닙니다 — 제미나이가 429 로 거절하고 봇이 그대로 알려줍니다.
AI_PER_GUILD_DAILY=150
# 제미나이가 이 시간 안에 답하지 않으면 포기합니다(ms).
AI_TIMEOUT_MS=30000
# 제미나이 쪽이 혼잡할 때(5xx) 몇 번 더 해볼지. 0이면 안 합니다.
# ⚠️ 한도 초과(429)와 시간 초과는 **일부러 재시도하지 않습니다.**
#    429 는 다시 던지면 상황이 나빠지고, 시간 초과는 30초를 또 기다리게 만듭니다.
AI_RETRIES=2
# 재시도 사이에 쉬는 시간(ms). 회차마다 배수로 늘어납니다 (1.5초 → 3초).
AI_RETRY_DELAY_MS=1500
