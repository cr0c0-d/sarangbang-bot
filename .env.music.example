# ─────────────────────────────────────────────────────────────
#  음악 전담 봇 설정  (봇을 둘로 나눠 돌릴 때만 씁니다)
#
#  실행:  npm run start:music
#  등록:  npm run deploy:music
#
#  이 파일에 적은 값이 .env 를 이깁니다. 여기 없는 값은 .env 것을 그대로 씁니다.
#  그러니 **다른 값만** 적으면 됩니다.
#
#  ⚠️ 반드시 디스코드 개발자 포털에서 **애플리케이션을 하나 더 만들어야** 합니다.
#     같은 토큰으로 두 번 띄우면 모든 명령에 두 번 답합니다.
#     (봇이 알아서 잡아내고 실행을 멈춥니다)
# ─────────────────────────────────────────────────────────────

# 이 봇이 맡을 역할.  all(전부) / music(음악만) / home(음악 빼고 전부)
BOT_ROLE=music

# 새로 만든 "음악 봇" 애플리케이션의 값입니다. .env 것과 **달라야** 합니다.
DISCORD_TOKEN=여기에_음악봇_토큰
CLIENT_ID=여기에_음악봇_애플리케이션_ID

# 설정을 나머지 봇과 섞지 않기 위해 저장 폴더를 따로 씁니다.
# (제어판 위치·지난 재생목록·음량이 여기 쌓입니다)
DATA_DIR=./data/music
