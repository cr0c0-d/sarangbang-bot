# ─────────────────────────────────────────────────────────────
#  노래하는 망고 — 음악 전담 봇
#
#  실행:  npm run start:music
#  등록:  npm run deploy:music
#
#  여기 적은 값이 .env 를 이깁니다. 없는 값은 .env 것을 그대로 씁니다.
#  그러니 **다른 값만** 적으면 됩니다. 보통 아래 4줄이면 끝입니다.
#
#  ⚠️ 디스코드 개발자 포털에서 **애플리케이션을 새로 만들어야** 합니다.
#     망고와 같은 토큰을 쓰면 모든 명령에 두 번 답하고,
#     명령어 등록이 서로를 지웁니다. (봇이 알아서 잡아내고 실행을 멈춥니다)
# ─────────────────────────────────────────────────────────────

# 이 봇이 누구인가.  mango = 망고 / music = 노래하는 망고
BOT_ROLE=music

# 새로 만든 "노래하는 망고" 애플리케이션의 값. .env 것과 **달라야** 합니다.
DISCORD_TOKEN=여기에_노래하는망고_토큰
CLIENT_ID=여기에_노래하는망고_애플리케이션_ID

# 설정을 망고와 섞지 않기 위해 저장 폴더를 따로 씁니다.
# (제어판 위치·지난 재생목록·음량이 여기 쌓입니다)
DATA_DIR=./data/music

# ─────────────────────────────────────────────────────────────
#  유튜브 차단 우회 — **음악 봇만 쓰는 설정입니다**
#
#  yt-dlp 는 노래하는 망고만 돌리므로, 쿠키·프록시 설정도 여기가 제자리입니다.
#  (.env 에 적어도 상속되어 동작은 하지만, 나중에 찾기 어렵습니다)
# ─────────────────────────────────────────────────────────────

# Oracle/AWS/GCP 같은 클라우드 서버에서 돌리면 유튜브가 그 IP를 거의 반드시 막습니다.
# 그때 브라우저에서 뽑은 쿠키 파일 경로를 넣어주면 대부분 풀립니다.
# ⚠️ 본인 주계정 쿠키를 쓰지 마세요. 계정이 제한될 수 있습니다. 따로 만든 계정을 쓰세요.
# (README 의 "유튜브가 막힐 때" 항목에 진단 명령과 대안이 있습니다)
YTDLP_COOKIES_FILE=

# 프록시를 거쳐야 한다면 (예: http://127.0.0.1:8080)
YTDLP_PROXY=

# yt-dlp 에 추가로 넘길 옵션이 있으면 (공백으로 구분)
YTDLP_EXTRA_ARGS=

# 느린 서버에서 yt-dlp 기동 비용을 줄이고 싶을 때 (기본 true 권장)
# 끄면 "n challenge solving failed" 가 나고 재생이 안 될 수 있습니다.
YTDLP_JS_RUNTIME=true

# ─────────────────────────────────────────────────────────────
#  음악 채널 (.env 에 적어뒀다면 여기 다시 안 적어도 됩니다)
# ─────────────────────────────────────────────────────────────

# 유튜브 링크를 감시할 채팅방. 비워두면 모든 채팅방에서 동작합니다.
# MUSIC_TEXT_CHANNEL_ID=
# 봇이 들어갈 음성채널. 비워두면 명령한 사람이 있는 음성채널로 들어갑니다.
# MUSIC_VOICE_CHANNEL_ID=
# 마지막 곡이 끝난 뒤 나가기까지 대기 시간(초). 0이면 안 나감.
# MUSIC_LEAVE_AFTER_SEC=300
