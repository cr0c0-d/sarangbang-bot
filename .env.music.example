# ─────────────────────────────────────────────────────────────
#  노래하는 망고 — 음악 전담 봇
#
#  실행:  npm run start:music
#  등록:  npm run deploy:music
#
#  여기 적은 값이 .env 를 이깁니다. 없는 값은 .env 것을 그대로 씁니다.
#  그러니 **다른 값만** 적으면 됩니다. 보통 아래 4줄이면 끝입니다.
#
#  ⚠️ 디스코드 개발자 포털에서 **애플리케이션을 새로 만들어야** 합니다.
#     망고와 같은 토큰을 쓰면 모든 명령에 두 번 답하고,
#     명령어 등록이 서로를 지웁니다. (봇이 알아서 잡아내고 실행을 멈춥니다)
# ─────────────────────────────────────────────────────────────

# 이 봇이 누구인가.  mango = 망고 / music = 노래하는 망고
BOT_ROLE=music

# 새로 만든 "노래하는 망고" 애플리케이션의 값. .env 것과 **달라야** 합니다.
DISCORD_TOKEN=여기에_노래하는망고_토큰
CLIENT_ID=여기에_노래하는망고_애플리케이션_ID

# 설정을 망고와 섞지 않기 위해 저장 폴더를 따로 씁니다.
# (제어판 위치·지난 재생목록·음량이 여기 쌓입니다)
DATA_DIR=./data/music

# ─────────────────────────────────────────────────────────────
#  유튜브 차단 우회 — **음악 봇만 쓰는 설정입니다**
#
#  yt-dlp 는 노래하는 망고만 돌리므로, 쿠키·프록시 설정도 여기가 제자리입니다.
#  (.env 에 적어도 상속되어 동작은 하지만, 나중에 찾기 어렵습니다)
# ─────────────────────────────────────────────────────────────

# Oracle/AWS/GCP 같은 클라우드 서버에서 돌리면 유튜브가 그 IP를 거의 반드시 막습니다.
# 그때 브라우저에서 뽑은 쿠키 파일 경로를 넣어주면 대부분 풀립니다.
# ⚠️ 본인 주계정 쿠키를 쓰지 마세요. 계정이 제한될 수 있습니다. 따로 만든 계정을 쓰세요.
# (README 의 "유튜브가 막힐 때" 항목에 진단 명령과 대안이 있습니다)
YTDLP_COOKIES_FILE=

# 프록시를 거쳐야 한다면 (예: http://127.0.0.1:8080)
YTDLP_PROXY=

# yt-dlp 에 추가로 넘길 옵션이 있으면 (공백으로 구분)
YTDLP_EXTRA_ARGS=

# ─────────────────────────────────────────────────────────────
#  느린 서버에서 가장 크게 줄일 수 있는 곳 — yt-dlp 기동
#
#  bin/ 에 받는 공식 바이너리는 PyInstaller 묶음이라 **실행할 때마다 파이썬을 통째로
#  풉니다.** 곡을 틀 때마다 그 비용이 그대로 깔립니다.
#  실측: 1코어 ARM 서버 3.1~5.7초 / 집 PC 1.6초
#
#  pip 로 깔면 푸는 과정이 없어 훨씬 빨리 뜹니다. 서버에서:
#
#    sudo apt install -y python3-venv            # 없으면 "ensurepip is not available"
#    python3 -m venv ~/.venv-ytdlp && ~/.venv-ytdlp/bin/pip install -U "yt-dlp[default]"
#    time ~/.venv-ytdlp/bin/yt-dlp --version     # 지금보다 빠른지 먼저 확인
#
#  ⚠️ **`[default]` 를 빼먹지 마세요.** 그냥 `yt-dlp` 로 깔면 최소 의존성만 들어와서,
#     손으로 돌리면 되는데 **봇에서만(쿠키를 쓰는 경로에서) 실패**합니다.
#     2026-09-02 에 실제로 겪었고 원인을 찾는 데 한참 걸렸습니다.
#
#  빨라지면 아래에 그 경로를 적으세요. 봇이 켜질 때 기동 시간을 로그에 찍으므로
#  **바꾼 효과가 바로 보입니다.** 되돌리려면 이 줄만 지우면 됩니다.
#  (적어두면 `npm run update-ytdlp` 가 pip 갱신 방법을 알려줍니다)
# YTDLP_PATH=/home/ubuntu/.venv-ytdlp/bin/yt-dlp
# ─────────────────────────────────────────────────────────────

# ⚠️ **끄지 마세요.** 2026-09-02 에 느린 서버에서 속도를 줄여보려고 껐다가
#    재생이 **아예 안 됐습니다.** 기동은 빨라지지만 유튜브 서명을 못 풀어서
#    "The page needs to be reloaded" 만 반복합니다.
#    (봇이 이 상황을 알아보고 "이 줄이 원인" 이라고 알려주긴 합니다)
YTDLP_JS_RUNTIME=true

# ─────────────────────────────────────────────────────────────
#  음악 채널 (.env 에 적어뒀다면 여기 다시 안 적어도 됩니다)
# ─────────────────────────────────────────────────────────────

# 유튜브 링크를 감시할 채팅방. 비워두면 모든 채팅방에서 동작합니다.
# MUSIC_TEXT_CHANNEL_ID=
# 봇이 들어갈 음성채널. 비워두면 명령한 사람이 있는 음성채널로 들어갑니다.
# MUSIC_VOICE_CHANNEL_ID=
# 마지막 곡이 끝난 뒤 나가기까지 대기 시간(초). 0이면 안 나감.
# ⚠️ **음성채널에 사람이 남아 있으면 이 시간이 지나도 나가지 않습니다.**
#    아무도 없어지면 그때 바로 나갑니다. (조용하다고 대화 중에 사라지면 안 되므로)
# MUSIC_LEAVE_AFTER_SEC=300

# 유튜브 주소를 ffmpeg 이 직접 받게 할지 (기본 true).
# 이게 되면 곡마다 yt-dlp 를 아예 안 돌려서 첫 소리까지 0.1초입니다.
# 다만 **쿠키를 쓰는 서버에서는 거의 항상 거부됩니다** — 쿠키로 뽑은 주소를
# ffmpeg 이 쿠키 없이 받기 때문입니다. 그러면 매번 헛걸음합니다.
# 봇이 두 번 연속 실패하면 알아서 끄고 로그로 알려주지만, 로그에
# "직접 수신이 계속 실패" 가 보이면 여기서 아예 꺼두는 편이 깔끔합니다.
#
# 꺼도 느려지지 않습니다. **뽑아둔 주소를 yt-dlp 가 받는 단계**(1.4초)로 시작하고,
# 그것까지 실패할 때만 전체 재추출(3.5초)로 내려갑니다. (ARCHITECTURE 3.1-2a)
MUSIC_DIRECT_STREAM=true

# 재생목록 링크 하나에서 담을 최대 곡 수 (기본 50).
# 수백 곡짜리 목록이 흔해서(실측 183곡) 상한이 없으면 대기열이 감당이 안 됩니다.
# 잘리면 "전체 N곡 중 앞 M곡" 이라고 알려줍니다.
MUSIC_PLAYLIST_MAX=50
